<?xml version="1.0" encoding="UTF-8"?>
<configuration>
<system.webServer>
  <handlers>
    <remove name="DjangoHandler" />
  </handlers>
  <security>
    <requestFiltering>
      <verbs allowUnlisted="true" />
    </requestFiltering>
  </security>
  <rewrite>
    <rules>
      <rule name="ReverseProxyInboundRule1" stopProcessing="true">
        <match url="(.*)" />
        <action type="Rewrite" url="http://127.0.0.1:8000/{R:1}" />
      </rule>
    </rules>
  </rewrite>
</system.webServer>

  <appSettings>
    <add key="WSGI_HANDLER" value="kttproject.wsgi.application" />
    <add key="PYTHONPATH" value="D:\KttProject\kttproject" />
    <add key="DJANGO_SETTINGS_MODULE" value="kttproject.settings" />
    <add key="WSGI_LOG" value="D:\KttProject\kttproject\logs\wfastcgi.log" />
  </appSettings>
</configuration>